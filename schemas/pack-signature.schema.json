{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analytics-spine/pack-signature/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "manifestDigest",
    "signedAt",
    "proof"
  ],
  "properties": {
    "kind": {
      "const": "analytics-spine-pack-signature"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "x-digest-domain": "exact raw manifest bytes"
    },
    "signedAt": {
      "type": "string",
      "format": "date-time"
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "proofBytes"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "proofBytes": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
