{
  "name": "@analytics-spine/domain-packs",
  "version": "0.1.0",
  "description": "Offline domain pack format validation and Ed25519 verification",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./schemas/*": "./schemas/*"
  },
  "bin": { "analytics-spine-pack": "./dist/cli.js" },
  "files": ["dist", "schemas", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src tests tools eslint.config.js --max-warnings 0",
    "test": "npm run build && vitest run --testTimeout=30000",
    "build": "tsc",
    "gate": "npm run typecheck && npm run lint && npm test",
    "scan:public": "node tools/scan-public.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
